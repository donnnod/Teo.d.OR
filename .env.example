# ── Convex (required) ──────────────────────────────────────────────
# Your Convex deployment URL (set by `npx convex dev` → auto-written to .env.local)
VITE_CONVEX_URL=https://your-project.convex.cloud

# Auth private key (RSA-2048 PKCS8, base64-encoded)
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt | base64 -w0
AUTH_PRIVATE_KEY=

# ── Teo Python Service (optional) ─────────────────────────────────
# Set to your Convex HTTP actions URL so Teo can push proposals to the dashboard
TEO_DASHBOARD_URL=https://your-project.convex.site

# Teo tuning (all optional — defaults work out of the box)
# TEO_DEFAULT_FORECASTER=baseline   # "baseline" | "kronos"
# TEO_SWEEP_TRIALS=32
# TEO_PORT=8001
